{
  "name": "miaoshou-auto-listing",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "妙手全自动上架辅助系统",
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm run dev:server\" \"npm run dev:web\"",
    "dev:web": "vite --config web/vite.config.js",
    "dev:server1": "node --watch-path=server --watch-path=.env server/index.js",
    "dev:server": "node server/index.js",
    "test:openai": "node scripts/test-openai.js",
    "test:price": "node scripts/test-price.js",
    "build": "vite build --config web/vite.config.js",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@openai/codex-sdk": "^0.155.1",
    "ali-oss": "^6.23.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "sharp": "^0.35.5",
    "undici": "^8.11.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.7"
  }
}
